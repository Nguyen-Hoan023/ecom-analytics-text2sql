# SQL Server source credentials. Fill these in your local .env; never commit that file.
XOM_SQLSERVER_HOST=
XOM_SQLSERVER_PORT=1433
XOM_SQLSERVER_DATABASE=
XOM_SQLSERVER_SCHEMA=e_commerce
XOM_SQLSERVER_USERNAME=
XOM_SQLSERVER_PASSWORD=

# Relative paths are resolved from the repository root.
DUCKDB_PATH=duckdb_warehouse/warehouse.duckdb
