# SQL Server source credentials. Fill these in your local .env; never commit that file.
SOURCE_SQLSERVER_HOST=
SOURCE_SQLSERVER_PORT=1433
SOURCE_SQLSERVER_DATABASE=
SOURCE_SQLSERVER_SCHEMA=e_commerce
SOURCE_SQLSERVER_USERNAME=
SOURCE_SQLSERVER_PASSWORD=

# Relative paths are resolved from the repository root.
DUCKDB_PATH=duckdb_warehouse/warehouse.duckdb

# Optional Text-to-SQL model settings. Keep the API key only in your local .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
