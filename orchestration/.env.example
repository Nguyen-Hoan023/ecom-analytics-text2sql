# Airflow & container settings
AIRFLOW__CORE__LOAD_EXAMPLES=False
DUCKDB_PATH=/usr/local/airflow/duckdb_warehouse/warehouse.duckdb
PYTHONPATH=/usr/local/airflow

# SQL Server source credentials (mapped from host .env)
XOM_SQLSERVER_HOST=
XOM_SQLSERVER_PORT=1433
XOM_SQLSERVER_DATABASE=
XOM_SQLSERVER_SCHEMA=e_commerce
XOM_SQLSERVER_USERNAME=
XOM_SQLSERVER_PASSWORD=
