# Airflow & container settings
AIRFLOW__CORE__LOAD_EXAMPLES=False
DUCKDB_PATH=/usr/local/airflow/duckdb_warehouse/warehouse.duckdb
PYTHONPATH=/usr/local/airflow

# SQL Server source credentials (mapped from host .env)
SOURCE_SQLSERVER_HOST=
SOURCE_SQLSERVER_PORT=1433
SOURCE_SQLSERVER_DATABASE=
SOURCE_SQLSERVER_SCHEMA=e_commerce
SOURCE_SQLSERVER_USERNAME=
SOURCE_SQLSERVER_PASSWORD=
